{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["github-commands.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": true,
    },
  },
  "permission": {
    "external_directory": {
      "*": "deny",
    },
  },
}
